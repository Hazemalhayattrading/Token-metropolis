{
  "name": "token-metropolis",
  "version": "0.1.0",
  "private": true,
  "description": "A living 3D city of the world's biggest AI platforms, sized by the tokens they process.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:data": "tsx scripts/build-data.ts",
    "build": "npm run build:data && tsc --noEmit -p tsconfig.json && vite build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "dev": "vite",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "gpt-tokenizer": "4.0.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
